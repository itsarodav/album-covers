---
import { site } from '../../data/site';
// Project icons (src/assets/icons), inlined by Astro at build time
import CalendarIcon from '../../assets/icons/calendar-cd.svg';
import CdIcon from '../../assets/icons/cd-icon.svg';
import UserIcon from '../../assets/icons/user-cd.svg';

---

<!-- Data of the selected CD, filled by scripts/ui/infoPanel.ts. A light card
     on the page's own colors,
     with a living glow of the cover's colors rising behind the artist row:
     side panel on desktop, bottom sheet below that. The CD is placed where
     this doesn't cover it (scripts/three/layout.ts). -->
<section
  class="info-panel"
  id="info-panel"
  role="dialog"
  aria-modal="false"
  aria-labelledby="info-panel-title"
  tabindex="-1"
  data-info-panel
  data-open="false"
  inert
>
  <!-- Cover colors (set by infoPanel.ts), rising behind the artist row -->
  <div class="info-panel__glow" aria-hidden="true" data-glow></div>

  <header class="info-panel__header">
    <p class="info-panel__badge info-panel__badge--format">
      <CdIcon class="info-panel__badge-icon" width={14} height={14} aria-hidden="true" />
      <span data-field="format"></span>
    </p>
    <p class="info-panel__badge info-panel__badge--year">
      <CalendarIcon class="info-panel__badge-icon" width={14} height={14} aria-hidden="true" />
      <span class="sr-only">{site.text.released}</span>
      <span data-field="year"></span>
    </p>
    <button class="info-panel__close" type="button" data-panel-close>
      <span class="sr-only">{site.text.close}</span>
      <!-- Drawn in CSS, like the menu's X: same stroke ($icon-stroke) -->
      <span class="info-panel__close-icon" aria-hidden="true"></span>
    </button>
  </header>

  <h2 class="info-panel__title" id="info-panel-title" data-field="title"></h2>
  <p class="info-panel__description" data-field="description"></p>

  <!-- Where to listen: outline chips -->
  <div class="info-panel__links">
    <a class="info-panel__chip" data-field="spotify" target="_blank" rel="noopener">
      <!-- Brand icons from linkims (public/icons) -->
      <svg class="info-panel__chip-icon info-panel__chip-icon--spotify" viewBox="4 4 40 40" width="14" height="14" aria-hidden="true">
        <path fill="currentColor" d="M35.8 21.8C29.4 18 18.7 17.6 12.6 19.5C11.6 19.8 10.6 19.2 10.3 18.3C10 17.3 10.6 16.3 11.5 16C18.6 13.9 30.3 14.3 37.7 18.7C38.6 19.2 38.9 20.4 38.4 21.3C37.9 22 36.7 22.3 35.8 21.8ZM35.6 27.4C35.1 28.1 34.2 28.4 33.5 27.9C28.1 24.6 19.9 23.6 13.6 25.6C12.8 25.8 11.9 25.4 11.7 24.6C11.5 23.8 11.9 22.9 12.7 22.7C20 20.5 29 21.6 35.2 25.4C35.8 25.7 36.1 26.7 35.6 27.4ZM33.2 32.9C32.8 33.5 32.1 33.7 31.5 33.3C26.8 30.4 20.9 29.8 13.9 31.4C13.2 31.6 12.6 31.1 12.4 30.5C12.2 29.8 12.7 29.2 13.3 29C20.9 27.3 27.5 28 32.7 31.2C33.4 31.5 33.5 32.3 33.2 32.9ZM24 4C21.3736 4 18.7728 4.51732 16.3463 5.52241C13.9198 6.5275 11.715 8.00069 9.85786 9.85786C6.10714 13.6086 4 18.6957 4 24C4 29.3043 6.10714 34.3914 9.85786 38.1421C11.715 39.9993 13.9198 41.4725 16.3463 42.4776C18.7728 43.4827 21.3736 44 24 44C29.3043 44 34.3914 41.8929 38.1421 38.1421C41.8929 34.3914 44 29.3043 44 24C44 21.3736 43.4827 18.7728 42.4776 16.3463C41.4725 13.9198 39.9993 11.715 38.1421 9.85786C36.285 8.00069 34.0802 6.5275 31.6537 5.52241C29.2272 4.51732 26.6264 4 24 4Z"></path>
      </svg>
      <span>{site.text.spotify}</span>
      <span class="sr-only">{site.text.newTab}</span>
    </a>
    <a class="info-panel__chip" data-field="youtube" target="_blank" rel="noopener">
      <svg class="info-panel__chip-icon info-panel__chip-icon--youtube" viewBox="4 8 40 32" width="14" height="11.2" aria-hidden="true">
        <!-- White play triangle under the logo's cut-out -->
        <path fill="#FFFFFF" d="M19 17h13v14H19z"></path>
        <path fill="currentColor" fill-rule="evenodd" clip-rule="evenodd" d="M24 8C25.71 8 27.464 8.044 29.164 8.116L31.172 8.212L33.094 8.326L34.894 8.448L36.538 8.576C38.3224 8.71178 40.0016 9.47287 41.2799 10.7252C42.5582 11.9775 43.3536 13.6408 43.526 15.422L43.606 16.272L43.756 18.092C43.896 19.978 44 22.034 44 24C44 25.966 43.896 28.022 43.756 29.908L43.606 31.728L43.526 32.578C43.3536 34.3595 42.5579 36.023 41.2792 37.2754C40.0004 38.5278 38.3207 39.2887 36.536 39.424L34.896 39.55L33.096 39.674L31.172 39.788L29.164 39.884C27.4437 39.9585 25.722 39.9972 24 40C22.278 39.9972 20.5563 39.9585 18.836 39.884L16.828 39.788L14.906 39.674L13.106 39.55L11.462 39.424C9.67763 39.2882 7.9984 38.5271 6.72009 37.2748C5.44178 36.0225 4.64638 34.3592 4.474 32.578L4.394 31.728L4.244 29.908C4.09167 27.9422 4.01028 25.9716 4 24C4 22.034 4.104 19.978 4.244 18.092L4.394 16.272L4.474 15.422C4.64631 13.6411 5.44142 11.9781 6.71933 10.7258C7.99723 9.47352 9.67598 8.71223 11.46 8.576L13.102 8.448L14.902 8.326L16.826 8.212L18.834 8.116C20.555 8.04145 22.2774 8.00278 24 8ZM20 19.15V28.85C20 29.774 21 30.35 21.8 29.89L30.2 25.04C30.3828 24.9348 30.5346 24.7832 30.6402 24.6007C30.7458 24.4181 30.8013 24.2109 30.8013 24C30.8013 23.7891 30.7458 23.5819 30.6402 23.3993C30.5346 23.2168 30.3828 23.0652 30.2 22.96L21.8 18.112C21.6175 18.0066 21.4105 17.9512 21.1998 17.9512C20.9891 17.9513 20.7821 18.0068 20.5997 18.1122C20.4172 18.2176 20.2657 18.3692 20.1605 18.5517C20.0552 18.7343 19.9999 18.9413 20 19.152V19.15Z"></path>
      </svg>
      <span>{site.text.youtube}</span>
      <span class="sr-only">{site.text.newTab}</span>
    </a>
  </div>

  <footer class="info-panel__footer">
    <!-- viewBox cropped to the icon's circle (the SVG has a 2.67 margin), so
         the circle itself measures the full 18px -->
    <UserIcon class="info-panel__avatar" viewBox="2.6665 2.6665 26.6669 26.6669" width={18} height={18} aria-hidden="true" />
    <p class="info-panel__artist" data-field="artist"></p>
    <!-- Icon only: the name lives in aria-label (set per artist in infoPanel.ts) -->
    <a class="info-panel__follow" data-field="instagram" target="_blank" rel="noopener">
      <svg viewBox="4 4 40 40" width="12" height="12" aria-hidden="true">
